{
  "name": "claude-usage",
  "version": "1.0.0",
  "description": "Claude Usage Tracker — Online + Local token analytics",
  "license": "MIT",
  "author": "mynrd <mynrd@live.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mynrd.claude-usage",
    "productName": "Claude Usage",
    "files": [
      "main.js",
      "preload.js",
      "price-history.json",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^25.0.0"
  }
}
